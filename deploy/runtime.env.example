# Bootstrap writes the real file to /opt/donhang-9chum/runtime.env with mode 0600.
# Never commit real values.
POSTGRES_DB=donhang
POSTGRES_USER=donhang_app
POSTGRES_PASSWORD=<generated-url-safe-password>
POSTGRES_ADMIN_USER=donhang_admin
POSTGRES_ADMIN_PASSWORD=<separate-generated-url-safe-password>
POSTGRES_MIGRATOR_USER=donhang_migrator
POSTGRES_MIGRATOR_PASSWORD=<third-generated-url-safe-password>
DATABASE_URL=postgresql://donhang_app:<generated-url-safe-password>@db:5432/donhang?schema=public
MIGRATION_DATABASE_URL=postgresql://donhang_migrator:<third-generated-url-safe-password>@db:5432/donhang?schema=public
POSTGRES_INIT_SCRIPT=/opt/donhang-9chum/postgres/init-app.sh
NODE_ENV=production
AUTH_SESSION_TTL_DAYS=7
AUTH_COOKIE_NAME=donhang_session
APP_ORIGIN=https://donhang.9chum.vn
APP_PORT=3101
BACKUP_DIR=/var/backups/donhang-9chum
SMOKE_URL=https://donhang.9chum.vn/api/health
